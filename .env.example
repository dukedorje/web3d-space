DATABASE_URL=local.db

# GPU ops console at /gpu (vite dev). Pages SSG skips these routes.
RUNPOD_API_KEY=
GPU_SSH_PUBLIC_KEY=
GPU_DEFAULT_TYPE=NVIDIA RTX PRO 4500 Blackwell
GPU_DEFAULT_DATACENTER=EU-RO-1
GPU_DEFAULT_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
GPU_POD_PREFIX=aicam-
GPU_AUTO_OFF=true
GPU_AUTO_OFF_MINUTES=30
